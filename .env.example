# All optional: with none of these set, the game is fully playable and VAOM's briefings are scripted.

# Which model writes the round briefings: "anthropic" (default) or "mistral".
LLM_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
MISTRAL_API_KEY=
MISTRAL_MODEL=
# A regional endpoint, for example https://api.eu.mistral.ai
MISTRAL_BASE_URL=

# Rate limits on the briefing endpoint (per IP, and overall per hour).
CLAUDE_RATE_PER_MINUTE=
CLAUDE_RATE_PER_HOUR=
CLAUDE_RATE_GLOBAL_PER_HOUR=

# Experimental voice narration: NEXT_PUBLIC_VOICE=1 at build time shows it; the voice route needs Azure
# Speech credentials.
NEXT_PUBLIC_VOICE=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_VOICE=
